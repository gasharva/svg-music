<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratedMusicXmlDir>$(IntermediateOutputPath)MusicXmlGenerated</GeneratedMusicXmlDir>
    <MusicXml40SchemaRoot>https://raw.githubusercontent.com/w3c-cg/musicxml/v4.0/schema</MusicXml40SchemaRoot>
  </PropertyGroup>

  <!--
    The serializer model is intentionally generated from the official, pinned MusicXML 4.0 XSD.
    We pass the two imported schemas explicitly because musicxml.xsd still references the old
    musicxml.org HTTP locations, which are unreliable for schema resolvers.
  -->
  <Target Name="GenerateMusicXml40Model" BeforeTargets="CoreCompile">
    <RemoveDir Directories="$(GeneratedMusicXmlDir)" />
    <MakeDir Directories="$(GeneratedMusicXmlDir)" />
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)/.." />
    <Exec
      Command="dotnet xscgen -n &quot;MusicXml.Generated&quot; -o &quot;$(GeneratedMusicXmlDir)&quot; --assemblyVisible --disableComments --forceUriScheme=https &quot;$(MusicXml40SchemaRoot)/xml.xsd&quot; &quot;$(MusicXml40SchemaRoot)/xlink.xsd&quot; &quot;$(MusicXml40SchemaRoot)/musicxml.xsd&quot;"
      WorkingDirectory="$(MSBuildProjectDirectory)/.." />
    <ItemGroup>
      <Compile Include="$(GeneratedMusicXmlDir)/**/*.cs" />
    </ItemGroup>
  </Target>
</Project>
