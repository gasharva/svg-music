<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MusicXml40SchemaBaseUrl>https://raw.githubusercontent.com/w3c-cg/musicxml/v4.0/schema</MusicXml40SchemaBaseUrl>
    <XsdNamespace>&lt;Namespace Prefix='xs' Uri='http://www.w3.org/2001/XMLSchema' /&gt;</XsdNamespace>
  </PropertyGroup>

  <!--
    Generate the serializer model with the same System.Xml.Serialization CodeDOM pipeline
    used by xsd.exe. This is important for MusicXML because repeated xs:choice content must
    stay as an ordered Items[] stream; XmlSchemaClassGenerator split those choices into
    separate collections and therefore reordered notes / backups / directions on round-trip.
  -->
  <Target Name="GenerateMusicXml40Model" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <MusicXmlSchemaDir>$(IntermediateOutputPath)MusicXmlSchema</MusicXmlSchemaDir>
      <GeneratedMusicXmlDir>$(IntermediateOutputPath)MusicXmlGenerated</GeneratedMusicXmlDir>
      <GeneratedMusicXmlFile>$(GeneratedMusicXmlDir)/MusicXml.Generated.cs</GeneratedMusicXmlFile>
    </PropertyGroup>

    <RemoveDir Directories="$(MusicXmlSchemaDir);$(GeneratedMusicXmlDir)" />
    <MakeDir Directories="$(MusicXmlSchemaDir);$(GeneratedMusicXmlDir)" />

    <DownloadFile SourceUrl="$(MusicXml40SchemaBaseUrl)/musicxml.xsd" DestinationFolder="$(MusicXmlSchemaDir)" DestinationFileName="musicxml.xsd" />
    <DownloadFile SourceUrl="$(MusicXml40SchemaBaseUrl)/xml.xsd" DestinationFolder="$(MusicXmlSchemaDir)" DestinationFileName="xml.xsd" />
    <DownloadFile SourceUrl="$(MusicXml40SchemaBaseUrl)/xlink.xsd" DestinationFolder="$(MusicXmlSchemaDir)" DestinationFileName="xlink.xsd" />

    <XmlPoke
      XmlInputPath="$(MusicXmlSchemaDir)/musicxml.xsd"
      Query="/xs:schema/xs:import[@namespace='http://www.w3.org/XML/1998/namespace']/@schemaLocation"
      Value="xml.xsd"
      Namespaces="$(XsdNamespace)" />
    <XmlPoke
      XmlInputPath="$(MusicXmlSchemaDir)/musicxml.xsd"
      Query="/xs:schema/xs:import[@namespace='http://www.w3.org/1999/xlink']/@schemaLocation"
      Value="xlink.xsd"
      Namespaces="$(XsdNamespace)" />

    <Exec
      Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/../MusicXmlModelGenerator/MusicXmlModelGenerator.csproj&quot; --configuration Release -- &quot;$(MusicXmlSchemaDir)&quot; &quot;$(GeneratedMusicXmlFile)&quot; MusicXml.Generated"
      WorkingDirectory="$(MSBuildProjectDirectory)" />

    <ItemGroup>
      <Compile Include="$(GeneratedMusicXmlFile)" />
    </ItemGroup>
  </Target>
</Project>
